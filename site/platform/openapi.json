{
  "components": {
    "schemas": {
      "EvaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": "evaluation",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/QueryRequest"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Queries",
            "type": "array"
          }
        },
        "required": [
          "queries"
        ],
        "title": "EvaluationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "canonical_unit": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Canonical Unit",
            "type": "string"
          },
          "query_id": {
            "default": "api-request",
            "maxLength": 120,
            "minLength": 1,
            "title": "Query Id",
            "type": "string"
          },
          "question": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "required_version": {
            "default": "final",
            "maxLength": 80,
            "minLength": 1,
            "title": "Required Version",
            "type": "string"
          },
          "target_period": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Target Period",
            "type": "string"
          }
        },
        "required": [
          "question",
          "as_of",
          "target_period",
          "canonical_unit"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Asynchronous, replayable ATLAS-RAG query and evaluation API with persistent traces and failure analytics.",
    "title": "FinAgent Audit Platform",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
