# All credentials remain on the server. Demo mode requires none.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Enable snapshot/live modes explicitly. Prefer a strong service token on a shared host.
FINAGENT_ENABLE_LIVE=false
FINAGENT_API_TOKEN=
FINAGENT_PUBLIC_LIVE=false
FINAGENT_LIVE_REQUESTS_PER_HOUR=5
FINAGENT_LIVE_GLOBAL_PER_DAY=12
SEC_USER_AGENT=FinAgentResearch/1.0 (your contact email or project URL)
FINAGENT_DB_PATH=build/workbench.sqlite3
FINAGENT_CACHE_DIR=build/workbench-cache
FINAGENT_MAX_WORKERS=2
FINAGENT_MAX_PENDING=16
FINAGENT_HTTP_TRUST_ENV=false
# Optional search provider; absent means report uses official SEC financial data.
TAVILY_API_KEY=
# Optional comma-separated browser origins, without trailing slash.
FINAGENT_ALLOWED_ORIGINS=
