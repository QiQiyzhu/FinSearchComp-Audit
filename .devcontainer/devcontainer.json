{
  "name": "FinAgent Research Workbench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install -r requirements-workbench.txt",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {"label": "FinAgent Workbench", "onAutoForward": "openBrowser", "visibility": "private"}
  },
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
